diff --git a/qemu/tcg/tcg-op.c b/qemu/tcg/tcg-op.c
index d0223ea..4883583 100644
--- a/qemu/tcg/tcg-op.c
+++ b/qemu/tcg/tcg-op.c
@@ -2872,6 +2872,20 @@ void check_exit_request(TCGContext *tcg_ctx)
     tcg_temp_free_ptr(tcg_ctx, puc);
 }
 
+// Unicorn patch: the exit check after a guest load or store is only needed when a
+// data memory hook (which may call uc_emu_stop) is installed at translation time.
+// Unmapped and protection faults already leave the block from the softmmu helper.
+// Adding such a hook later needs a TB flush (uc_ctl_flush_tb) to take effect.
+static void check_exit_request_ldst(TCGContext *tcg_ctx)
+{
+    struct uc_struct *uc = tcg_ctx->uc;
+    if (!HOOK_EXISTS(uc, UC_HOOK_MEM_READ) && !HOOK_EXISTS(uc, UC_HOOK_MEM_WRITE) &&
+        !HOOK_EXISTS(uc, UC_HOOK_MEM_READ_AFTER)) {
+        return;
+    }
+    check_exit_request(tcg_ctx);
+}
+
