 {
 #ifdef TCG_GUEST_DEFAULT_MO
@@ -2917,7 +2931,7 @@ void tcg_gen_qemu_ld_i32(TCGContext *tcg_ctx, TCGv_i32 val, TCGv addr, TCGArg id
         }
     }
 
-    check_exit_request(tcg_ctx);
+    check_exit_request_ldst(tcg_ctx);
 }
 
