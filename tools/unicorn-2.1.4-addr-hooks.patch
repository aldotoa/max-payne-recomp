+// The address-indexed code hooks at one address, run after the ranged code hooks
+// of helper_uc_tracecode (the ranged hooks keep their order, the indexed ones
+// keep theirs). Same to_delete and stop_request rules as the list loop.
+static void code_addr_dispatch(uc_engine *uc, int64_t address, int32_t size,
+                               bool not_allow_stop)
+{
+    struct list *bucket = code_addr_bucket(uc, (uint64_t)address);
+    struct list_item *cur;
+    struct hook *hook;
+
+    if (bucket == NULL) {
+        return;
+    }
+
+    for (cur = bucket->head; cur != NULL && (hook = (struct hook *)cur->data);
+         cur = cur->next) {
+        if (hook->to_delete) {
+            continue;
+        }
+
+        if (HOOK_BOUND_CHECK(hook, (uint64_t)address)) {
+            JIT_CALLBACK_GUARD(((uc_cb_hookcode_t)hook->callback)(
+                uc, address, size, hook->user_data));
+        }
+
+        if (not_allow_stop && uc->stop_request) {
+            revert_uc_emu_stop(uc);
+        } else if (!not_allow_stop && uc->stop_request) {
+            break;
+        }
+    }
+}
+
 void helper_uc_tracecode(int32_t size, uc_hook_idx index, void *handle,
                          int64_t address);
 void helper_uc_tracecode(int32_t size, uc_hook_idx index, void *handle,
@@ -2162,6 +2349,13 @@ void helper_uc_tracecode(int32_t size, uc_hook_idx index, void *handle,
             break;
         }
     }
+
+    // the ranged loop above ends without a stop request, unless it was allowed
+    // to be stopped (not_allow_stop reverts it)
+    if (index == UC_HOOK_CODE_IDX && hook_code_addr_any(uc) &&
+        !(uc->stop_request && !not_allow_stop)) {
+        code_addr_dispatch(uc, address, size, not_allow_stop);
+    }
