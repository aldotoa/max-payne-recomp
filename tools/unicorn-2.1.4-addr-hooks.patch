diff --git a/uc.c b/uc.c
index 75b89a0..34bec5a 100644
--- a/uc.c
+++ b/uc.c
@@ -111,6 +111,134 @@ static void hook_delete(void *data)
     }
 }
 
+// Single-address UC_HOOK_CODE hooks (begin == end) are indexed by address in
+// uc->code_addr_hooks, so that translation and helper_uc_tracecode do not walk
+// every such hook for each instruction. They are not on hook[UC_HOOK_CODE_IDX],
+// which keeps the ranged code hooks (and the instruction counter). A bucket is a
+// struct list of the hooks at one address that uses hook_delete for its entries.
+static guint code_addr_hash(gconstpointer key)
+{
+    uint64_t addr = *(const uint64_t *)key;
+
+    return (guint)(addr ^ (addr >> 32));
+}
+
+static gboolean code_addr_equal(gconstpointer a, gconstpointer b)
+{
+    return *(const uint64_t *)a == *(const uint64_t *)b;
+}
+
+static struct list *code_addr_bucket(uc_engine *uc, uint64_t addr)
+{
+    if (uc->code_addr_hooks == NULL) {
+        return NULL;
+    }
+    return g_hash_table_lookup(uc->code_addr_hooks, &addr);
+}
+
+static void *code_addr_insert(uc_engine *uc, struct hook *hook)
+{
+    struct list *bucket = code_addr_bucket(uc, hook->begin);
+    uint64_t *key;
+
+    if (bucket != NULL) {
+        return hook_append(bucket, hook);
+    }
+
+    if (uc->code_addr_hooks == NULL) {
+        uc->code_addr_hooks = g_hash_table_new_full(
+            code_addr_hash, code_addr_equal, g_free, NULL);
+    }
+    key = malloc(sizeof(*key));
+    bucket = list_new();
+    if (key == NULL || bucket == NULL) {
+        free(key);
+        free(bucket);
+        return NULL;
+    }
+    *key = hook->begin;
+    bucket->delete_fn = hook_delete;
+    g_hash_table_insert(uc->code_addr_hooks, key, bucket);
+
+    return hook_append(bucket, hook);
+}
+
+// removes the hook from its address bucket, if it is in one
+static void code_addr_remove(uc_engine *uc, struct hook *hook)
+{
+    uint64_t addr = hook->begin;
+    struct list *bucket = code_addr_bucket(uc, addr);
+
+    if (bucket == NULL || !list_remove(bucket, (void *)hook)) {
+        return;
+    }
+    if (bucket->head == NULL) {
+        g_hash_table_remove(uc->code_addr_hooks, &addr);
+        free(bucket);
+    }
+}
+
+static void code_addr_free_bucket(gpointer key, gpointer value, gpointer opaq)
+{
+    struct list *bucket = (struct list *)value;
+
+    list_clear(bucket);
+    free(bucket);
+}
+
+struct code_addr_find {
+    struct hook *hook;
+    bool found;
+};
+
+static void code_addr_find_bucket(gpointer key, gpointer value, gpointer opaq)
+{
+    struct code_addr_find *find = (struct code_addr_find *)opaq;
+
+    if (!find->found && list_exists((struct list *)value, (void *)find->hook)) {
+        find->found = true;
+    }
+}
+
+// true if the hook is an address-indexed code hook; only compares pointers
+static bool code_addr_contains(uc_engine *uc, struct hook *hook)
+{
+    struct code_addr_find find = {hook, false};
+
+    if (uc->code_addr_hooks != NULL) {
+        g_hash_table_foreach(uc->code_addr_hooks, code_addr_find_bucket, &find);
+    }
+    return find.found;
+}
+
+bool hook_code_addr_any(uc_engine *uc)
+{
+    return uc->code_addr_hooks != NULL &&
+           g_hash_table_size(uc->code_addr_hooks) > 0;
+}
+
+// like HOOK_EXISTS_BOUNDED(uc, UC_HOOK_CODE, addr), for the whole code hook set
+bool hook_code_exists_bounded(uc_engine *uc, uint64_t addr)
+{
+    struct list *bucket;
+
+    if (_hook_exists_bounded(uc->hook[UC_HOOK_CODE_IDX].head, addr)) {
+        return true;
+    }
+    bucket = code_addr_bucket(uc, addr);
+    return bucket != NULL && _hook_exists_bounded(bucket->head, addr);
+}
+
+// the hooked-region bookkeeping of hooked_regions_check() for the code hooks
+void hooked_code_addr_regions(uc_engine *uc, uint64_t start, uint64_t length)
+{
+    struct list *bucket = code_addr_bucket(uc, start);
+
+    if (bucket != NULL) {
+        hooked_regions_check_single(bucket->head, start, length);
+    }
+}
+
